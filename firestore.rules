rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Directives & announcements
    match /directives/{directiveId} {
      allow read, write: if true;
    }

    // Tasks & operational items
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Central Hub data
    match /hub/{document=**} {
      allow read, write: if true;
    }

    // System configurations & settings
    match /config/{document=**} {
      allow read, write: if true;
    }

    // App State backup & recovery document
    match /app_state/{document=**} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
