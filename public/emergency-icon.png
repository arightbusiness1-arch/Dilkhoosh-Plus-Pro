<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <!-- Outer Red Rounded Triangle -->
  <path 
    d="M 256 32
       C 272 32, 286 42, 294 56
       L 490 408
       C 498 422, 498 440, 490 454
       C 482 468, 468 476, 452 476
       L 60 476
       C 44 476, 30 468, 22 454
       C 14 440, 14 422, 22 408
       L 218 56
       C 226 42, 240 32, 256 32 Z" 
    fill="#E60028"
  />
  
  <!-- Inner White Triangle Outline -->
  <path 
    d="M 256 68
       C 266 68, 274 74, 280 84
       L 462 408
       C 468 418, 468 430, 462 440
       C 456 450, 446 456, 434 456
       L 78 456
       C 66 456, 56 450, 50 440
       C 44 430, 44 418, 50 408
       L 232 84
       C 238 74, 246 68, 256 68 Z" 
    fill="#E60028" 
    stroke="#FFFFFF" 
    stroke-width="18" 
    stroke-linejoin="round"
  />
  
  <!-- Exclamation Mark Top Bar (White with rounded ends) -->
  <path 
    d="M 234 165
       C 234 150, 244 138, 256 138
       C 268 138, 278 150, 278 165
       L 272 315
       C 272 325, 264 333, 256 333
       C 248 333, 240 325, 240 315
